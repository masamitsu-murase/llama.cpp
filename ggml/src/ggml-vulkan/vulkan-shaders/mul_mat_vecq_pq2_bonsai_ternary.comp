#version 450

#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require
#extension GL_EXT_integer_dot_product : require

#define MMQ
#define B_TYPE block_q8_1_x4

#include "mul_mat_vec_base.glsl"

layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;

#if !defined(DATA_A_PQ2_0) || !defined(DATA_A_PQ2_0_BONSAI_TERNARY)
#error This shader only supports validated Bonsai ternary PQ2_0
#endif

#if defined(BONSAI_PQ2_XE1) && defined(BONSAI_PQ2_XE2)
#error Select only one Bonsai PQ2 subgroup mapping
#endif

#define K_PER_ITER 16

uint a_offset, b_offset, d_offset;
int32_t cache_b_qs[4];
vec2 cache_b_ds;

uint pq2_ternary4(uint bits) {
    bits &= 0xffu;
    bits = (bits | (bits << 12u)) & 0x000f000fu;
    bits = (bits | (bits << 6u)) & 0x03030303u;
    return ((bits ^ 0x80808080u) - 0x01010101u) ^ 0x80808080u;
}

FLOAT_TYPE pq2_scale_dot(const int32_t q_sum, const float da, const vec2 dsb) {
    return FLOAT_TYPE(da * float(q_sum) * dsb.x);
}

i32vec4 pq2_load16(const uint ib, const uint iqs) {
    const uint qs_idx = (ib & 3u) * 4u + iqs * 2u;
    const uint bits = pack32(u16vec2(data_a_packed16[ib / 4].qs[qs_idx],
                                     data_a_packed16[ib / 4].qs[qs_idx + 1]));
    return i32vec4(int32_t(pq2_ternary4(bits)), int32_t(pq2_ternary4(bits >> 8u)),
                   int32_t(pq2_ternary4(bits >> 16u)), int32_t(pq2_ternary4(bits >> 24u)));
}

#if defined(BONSAI_PQ2_XE1)
FLOAT_TYPE pq2_dot_lane(const uint a_block_base, const uint b_block_base, const uint lane, const float da) {
    const uint chunk32 = lane >> 1u;
    const uint half16 = lane & 1u;
    const i32vec4 qs_a = pq2_load16(a_block_base + chunk32, half16);
    const uint b_block_idx = b_block_base + chunk32;
    const uint b_outer = b_block_idx / 4u;
    const uint b_inner = b_block_idx & 3u;
    const uint b_qs_idx = b_inner * 8u + half16 * 4u;
    int32_t q_sum = 0;
    q_sum += dotPacked4x8EXT(qs_a.x, data_b[b_outer].qs[b_qs_idx]);
    q_sum += dotPacked4x8EXT(qs_a.y, data_b[b_outer].qs[b_qs_idx + 1u]);
    q_sum += dotPacked4x8EXT(qs_a.z, data_b[b_outer].qs[b_qs_idx + 2u]);
    q_sum += dotPacked4x8EXT(qs_a.w, data_b[b_outer].qs[b_qs_idx + 3u]);
    const float db = float(vec2(data_b[b_outer].ds[b_inner]).x);
    return FLOAT_TYPE(da * db * float(q_sum));
}
#elif defined(BONSAI_PQ2_XE2)
FLOAT_TYPE pq2_dot_lane(const uint a_block_base, const uint b_block_base, const uint lane, const float da) {
    const uint chunk32 = lane >> 2u;
    const uint half8 = lane & 3u;
    const uint a_idx = ((a_block_base + chunk32) & 3u) * 4u + half8;
    const uint bits = uint(data_a_packed16[(a_block_base + chunk32) / 4u].qs[a_idx]);
    const int32_t qs_a0 = int32_t(pq2_ternary4(bits & 0xffu));
    const int32_t qs_a1 = int32_t(pq2_ternary4(bits >> 8u));
    const uint b_block_idx = b_block_base + chunk32;
    const uint b_outer = b_block_idx / 4u;
    const uint b_inner = b_block_idx & 3u;
    const uint b_qs_idx = b_inner * 8u + half8 * 2u;
    int32_t q_sum = 0;
    q_sum += dotPacked4x8EXT(qs_a0, data_b[b_outer].qs[b_qs_idx]);
    q_sum += dotPacked4x8EXT(qs_a1, data_b[b_outer].qs[b_qs_idx + 1u]);
    const float db = float(vec2(data_b[b_outer].ds[b_inner]).x);
    return FLOAT_TYPE(da * db * float(q_sum));
}
#endif

FLOAT_TYPE mmvq_dot_product(const uint ib_a, const uint iqs) {
    const i32vec4 qs_a = pq2_load16(ib_a, iqs);
    int32_t q_sum = 0;
    q_sum += dotPacked4x8EXT(qs_a.x, cache_b_qs[0]);
    q_sum += dotPacked4x8EXT(qs_a.y, cache_b_qs[1]);
    q_sum += dotPacked4x8EXT(qs_a.z, cache_b_qs[2]);
    q_sum += dotPacked4x8EXT(qs_a.w, cache_b_qs[3]);
    return pq2_scale_dot(q_sum, float(data_a[ib_a / 4].d), cache_b_ds);
}

void iter(inout FLOAT_TYPE temp[NUM_COLS][NUM_ROWS], const uint first_row, const uint num_rows, const uint col, const uint b_qs_idx) {
    [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
        const uint b_block_idx = (j*p.batch_stride_b + col) / QUANT_K_Q8_1 + b_offset;
        const uint b_block_idx_outer = b_block_idx / 4;
        const uint b_block_idx_inner = b_block_idx % 4;
        cache_b_ds = vec2(data_b[b_block_idx_outer].ds[b_block_idx_inner]);

        cache_b_qs[0] = data_b[b_block_idx_outer].qs[b_block_idx_inner * 8 + b_qs_idx * 4    ];
        cache_b_qs[1] = data_b[b_block_idx_outer].qs[b_block_idx_inner * 8 + b_qs_idx * 4 + 1];
        cache_b_qs[2] = data_b[b_block_idx_outer].qs[b_block_idx_inner * 8 + b_qs_idx * 4 + 2];
        cache_b_qs[3] = data_b[b_block_idx_outer].qs[b_block_idx_inner * 8 + b_qs_idx * 4 + 3];

        uint ibi = first_row*p.ncols;
        [[unroll]] for (uint n = 0; n < num_rows; ++n) {
            const uint a_block_idx = (ibi + col)/QUANT_K_Q8_1 + a_offset;
            ibi += p.ncols;
            temp[j][n] += mmvq_dot_product(a_block_idx, b_qs_idx);
        }
    }
}

void compute_outputs(const uint32_t first_row, const uint32_t num_rows) {
    const uint tid = gl_LocalInvocationID.x;

    get_offsets(a_offset, b_offset, d_offset);
    a_offset *= QUANT_K / QUANT_K_Q8_1;
    b_offset /= QUANT_K_Q8_1;

    FLOAT_TYPE temp[NUM_COLS][NUM_ROWS];

    [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
        [[unroll]] for (uint n = 0; n < num_rows; ++n) {
            temp[j][n] = FLOAT_TYPE(0.0f);
        }
    }

#if defined(BONSAI_PQ2_XE1) || defined(BONSAI_PQ2_XE2)
    const uint num_blocks = p.ncols / QUANT_K;
    [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
        [[unroll]] for (uint n = 0; n < num_rows; ++n) {
            for (uint block = 0; block < num_blocks; ++block) {
                const uint a_block_base = ((first_row + n) * p.ncols + block * QUANT_K) / QUANT_K_Q8_1 + a_offset;
                const uint b_block_base = (j * p.batch_stride_b + block * QUANT_K) / QUANT_K_Q8_1 + b_offset;
                const float da = float(data_a[a_block_base / 4u].d);
                temp[j][n] += pq2_dot_lane(a_block_base, b_block_base, tid, da);
            }
        }
    }

    reduce_result(temp, d_offset, first_row, num_rows, tid);
#else

    const uint col_stride = K_PER_ITER * BLOCK_SIZE;
    uint num_iters = p.ncols / col_stride;
    if (num_iters * col_stride + K_PER_ITER * tid < p.ncols) {
        num_iters++;
    }

    const uint b_qs_idx = tid % (32 / K_PER_ITER);
    uint col = tid * K_PER_ITER;
    while (num_iters >= 4) {
        [[unroll]] for (uint k = 0; k < 4; ++k) {
            iter(temp, first_row, num_rows, col, b_qs_idx);
            col += col_stride;
        }
        num_iters -= 4;
    }

    if (num_iters >= 2) {
        iter(temp, first_row, num_rows, col, b_qs_idx);
        col += col_stride;
        iter(temp, first_row, num_rows, col, b_qs_idx);
        col += col_stride;
        num_iters -= 2;
    }

    if (num_iters > 0) {
        iter(temp, first_row, num_rows, col, b_qs_idx);
    }

    reduce_result(temp, d_offset, first_row, num_rows, tid);
#endif
}

void main() {
    const uint first_row = NUM_ROWS * (gl_WorkGroupID.x + gl_NumWorkGroups.x * gl_WorkGroupID.z);

    if (first_row + NUM_ROWS <= p.stride_d) {
        compute_outputs(first_row, NUM_ROWS);
    } else {
        if (first_row >= p.stride_d) {
            return;
        }
        compute_outputs(first_row, p.stride_d - first_row);
    }
}
